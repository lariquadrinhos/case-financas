# Copie para .env e preencha. O .env NUNCA é commitado (ADR-0009, .gitignore).
# Aqui só entram NOMES de variável, nunca valor.

# Caminho do banco local. Padrão: ./.data/bigorna.db
# DATABASE_PATH=

# Open Finance pela Pluggy (ADR-0020). Sem as três, o app funciona como antes
# e as rotas /api/v1/open-finance respondem 409 open_finance.not_configured.
# Credenciais da aplicação, do painel do Meu Pluggy (meu.pluggy.ai):
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Ids das conexões (itemId) de cada banco conectado no Meu Pluggy, separados
# por vírgula. A Pluggy não tem endpoint que liste as conexões de uma
# aplicação, então elas são informadas aqui.
PLUGGY_ITEM_IDS=
